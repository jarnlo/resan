# Bara bilder härifrån: inga skript körs och ingen mapplistning.
Options -Indexes -ExecCGI
<FilesMatch "\.(php|phtml|phar|pl|py|cgi|sh|json)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.jpg$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
